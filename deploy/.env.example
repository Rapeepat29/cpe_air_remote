# ตัวอย่างไฟล์ .env ของเซิร์ฟเวอร์จริง
# ไม่ต้องกรอกเอง ให้รัน:  bash init-env.sh  (สุ่มรหัสทุกตัวให้)

# โดเมนที่ชี้มาที่เซิร์ฟเวอร์นี้ ใช้ทั้งเว็บ, API และ MQTTS ของ ESP32
DOMAIN=energy.example.rmutt.ac.th

# MariaDB
DB_DATABASE=rmutt_save_energy
# root ใช้เฉพาะงานดูแลระบบ (backup, db-view.sh)
DB_ROOT_PASSWORD=
# user ของ Backend มีสิทธิ์เฉพาะฐานข้อมูลข้างบน
DB_USER=rmutt_app
DB_PASSWORD=

# Backend secrets — แต่ละค่าต้องไม่ซ้ำกัน อย่างน้อย 32 ตัวอักษร
JWT_SECRET=
OTP_PEPPER=
JWT_EXPIRES_IN=8h
OTP_EXPIRES_MINUTES=10

# MQTT
# MQTT_USERNAME/PASSWORD คือบัญชีของ Backend (เป็นผู้ดูแล Dynamic Security ด้วย)
# บอร์ดแต่ละตัวได้บัญชีของตัวเอง รหัสคำนวณจาก MQTT_DEVICE_SECRET
# ถ้าเปลี่ยน MQTT_DEVICE_SECRET ต้องตั้งค่าบอร์ดทุกตัวผ่านบลูทูธใหม่
MQTT_USERNAME=rmutt_backend
MQTT_PASSWORD=
MQTT_DEVICE_SECRET=

# SMTP สำหรับ OTP ลืมรหัสผ่าน
# Gmail ต้องใช้ App Password และ SMTP_FROM ต้องมีอีเมลในวงเล็บ <>
# ถ้ามหาวิทยาลัยมี SMTP relay ของตัวเอง ใช้ของมหาวิทยาลัยจะส่งถึงกล่องจดหมายดีกว่า
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RMUTT Save Energy <your.account@gmail.com>"

# บัญชีแอดมินตัวแรก
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=0800000000

# สำรองฐานข้อมูล (backup-db.sh)
BACKUP_KEEP_DAYS=14
# ปลายทางสำรองนอกเครื่อง (ไม่บังคับ) เช่น user@nas.rmutt.ac.th:/backup/rmutt
BACKUP_REMOTE=

LEGACY_PHONE_PREFIX=0
