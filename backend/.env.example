NODE_ENV=development
PORT=3000
APP_ORIGIN=*
# จำนวนชั้น reverse proxy หน้า Backend (Caddy = 1) รันตรงบนเครื่องให้เว้นว่าง
TRUST_PROXY=

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_this_database_password
DB_DATABASE=rmutt_save_energy
DB_CONNECTION_LIMIT=5

# Generate each value separately:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
OTP_PEPPER=replace_with_a_different_32_character_secret
OTP_EXPIRES_MINUTES=10

# Development: OTP is printed only in the Backend terminal.
# Production: change MAIL_MODE to smtp and complete the SMTP values.
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RMUTT Save Energy <your.account@gmail.com>"

# MQTT values are filled automatically by mqtt/setup_mqtt.ps1.
# MQTT_URL must use the computer LAN IPv4 address, never 127.0.0.1,
# because the ESP32 must be able to reach the broker over Wi-Fi.
MQTT_REQUIRED=true
MQTT_URL=mqtt://192.168.1.10:1883
MQTT_USERNAME=rmutt_air
MQTT_PASSWORD=replace_by_mqtt_setup_script
MQTT_TOPIC_PREFIX=rmutt/ac
MQTT_OCCUPANCY_TOPIC_PREFIX=rmutt/occupancy
# shared = บอร์ดทุกตัวใช้บัญชีเดียวกับ Backend (ใช้กับ Broker ทดสอบในโฟลเดอร์ mqtt/)
# dynsec = บอร์ดแต่ละตัวมีบัญชีของตัวเอง (ใช้จริง ต้องใช้ Mosquitto Dynamic Security)
MQTT_DEVICE_AUTH=shared
# ใช้เมื่อ MQTT_DEVICE_AUTH=dynsec: ความลับสำหรับคำนวณรหัสผ่าน MQTT ของบอร์ด
MQTT_DEVICE_SECRET=

# โฟลเดอร์ไฟล์ .bin สำหรับอัปเดตบอร์ดผ่าน Wi-Fi (เว้นว่างได้ตอนพัฒนา)
FIRMWARE_DIR=

# Optional account used by npm run seed:admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_admin_password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=0800000000

# Optional legacy migration
LEGACY_PHONE_PREFIX=0
